name = "Flat"

[shaders]
vertex   = { resource = "shaders/flat", entry = "vertexMain" }
fragment = { resource = "shaders/flat", entry = "fragmentMain" }

[raster]
cullMode = "Back"
frontFace = "Clockwise"

[properties]
tint   = { type = "vec4", value = [1.0, 1.0, 1.0, 1.0] }
fade   = { type = "float", value = 1.0 }
albedo = { type = "tex2D", value = "textures/white" }

[hints]
frequentUpdates = false