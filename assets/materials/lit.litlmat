name = "Unlit"

[shaders]
vertex   = { resource = "shaders/lit", entry = "vertexMain" }
fragment = { resource = "shaders/lit", entry = "fragmentMain" }

[properties]
tint   = { type = "color", value = [1.0, 1.0, 1.0, 1.0] }
albedo = { type = "texture", value = "white" }                  # "white" is one of the reserved, globally present textures. Others include: "pink", "black", and "normal".