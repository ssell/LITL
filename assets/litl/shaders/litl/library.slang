// -----------------------------------------------------------------------------------------
// [library.slang]
// Includes all commonly used LITL modules.
// -----------------------------------------------------------------------------------------

module library;

__exported import common;               // Common constants and utilities
__exported import input;                // Vertex input structures, push constants, etc.
__exported import textures;             // Predefined samplers, global texture table operations
__exported import lighting;             // Light structures and calculations, exports BRDF surface